# Copy to `.env.local` for `yarn dev`, or to `.env` for `docker compose`.

NEXT_PUBLIC_API_BASE_URL=

# Site origin for Open Graph absolute URLs (e.g. https://yersultan-akerke.noorfamilyapp.kz). Dev default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Host port for docker compose (container always listens on 3000)
PORT=3000
